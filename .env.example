# Configura valores reales en el entorno; este archivo no contiene credenciales.
PORT=3000
PUBLIC_URL=https://tu-bot.example.com
WEBHOOK_AUTH_MODE=strict

# Salida WhatsApp mediante Twilio (también cuando entra por Chatwoot)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Opcional en lugar del número de origen
TWILIO_MESSAGING_SERVICE_SID=

# Conversaciones y atención humana en Chatwoot
CHATWOOT_ENABLED=true
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_TOKEN=

# Google Apps Script existente: responde {"ok":true}
GOOGLE_SCRIPT_EMAIL_URL=
GOOGLE_SCRIPT_EMAIL_KEY=
MAIL_TO_ADMIN=

# Valores actuales del repositorio; confirmar vigencia comercial
CRC_PRECIO_UNA_CATEGORIA=180000
CRC_PRECIO_DOS_CATEGORIAS=250000
CRC_AGENDA_REMINDER_ENABLED=true
CRC_AGENDA_REMINDER_MINUTES=3
# Opcional; vacío usa el enlace existente
CRC_MAPS_URL=

# IA opcional; el flujo funciona sin esta clave
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Panel y PostgreSQL (opcional en desarrollo)
DASHBOARD_USER=
DASHBOARD_PASS=
DATABASE_URL=
PG_SSL_REJECT_UNAUTHORIZED=true

# Solo para una integración directa adicional con Meta
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
VERIFY_TOKEN=
META_API_VERSION=v23.0
